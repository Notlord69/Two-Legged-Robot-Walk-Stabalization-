<?xml version="1.0" ?>
<robot name="Siclo1" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<transmission name="Left_Hip_Twist_tran">
  <type>transmission_interface/SimpleTransmission</type>
  <joint name="Left_Hip_Twist">
    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
  </joint>
  <actuator name="Left_Hip_Twist_actr">
    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    <mechanicalReduction>1</mechanicalReduction>
  </actuator>
</transmission>

