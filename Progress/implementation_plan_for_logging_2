### 2. HeartBeat.py — Fast Path Producer + TelemetryThread Consumer

#### [MODIFY] [HeartBeat.py](file:///home/notlord/ros2_ws/Siclo1_V1/HeartBeat.py)

**A. Replace `_BufferedLog` with `TelemetryThread`:**

```python
class TelemetryThread(threading.Thread):
    """
    Low-priority consumer thread.
    Drains TelemetryRingBuffer at ~10Hz.
    All string formatting and stdout I/O happens HERE, never in the Heartbeat.
    """
    daemon = True
    
    def __init__(self, state: Siclo1State):
        super().__init__(name="TelemetryConsumer")
        self._state = state
        self._stop_event = threading.Event()
        self._log_lines: list = []  # Only the consumer thread touches this
    
    def run(self):
        while not self._stop_event.is_set():
            batch = self._state.telemetry.read_batch()
            if batch.shape[0] > 0:
                self._format_batch(batch)
            self._stop_event.wait(timeout=0.1)  # ~10Hz
    
    def _format_batch(self, batch: np.ndarray):
        """Convert raw numeric rows to human-readable lines (slow path)."""
        for row in batch:
            ts, cycle, err, cx, cy, cz, lc, rc, stab, lf, rf, margin, comp_us, *_ = row
            line = (f"[t={ts:7.3f}s c={int(cycle):>6d}] "
                    f"COM=[{cx:+.3f},{cy:+.3f},{cz:+.3f}] "
                    f"L={int(lc)} R={int(rc)} Stab={int(stab)} "
                    f"F=[{lf:.0f},{rf:.0f}] "
                    f"margin={margin:.4f} "
                    f"compute={comp_us:.0f}µs")
            if int(err) > 0:
                line += f" ERR={int(err)}"
            self._log_lines.append(line)
    
    def stop(self):
        self._stop_event.set()
    
    def flush_to_stdout(self):
        for line in self._log_lines:
            print(line)
        self._log_lines.clear()
```

